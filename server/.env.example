[TEMPLATE]
PORT=3000
MONGO_URI=mongodb://localhost:27017/studiomind
PARALLEL_API_KEY=your_parallel_api_key_here

# --- Gemini transport: pick ONE ---
# Option A (default): public Gemini API keyed by GEMINI_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here
# Option B: Vertex AI (ADC auth — locally `gcloud auth application-default login`,
# on Cloud Run the attached service account). Set USE_VERTEX=true and the
# project/location; GEMINI_API_KEY is then ignored.
#USE_VERTEX=true
#GCP_PROJECT_ID=your-gcp-project-id
#GCP_LOCATION=us-central1

# Optional: model override. Code falls back to gemini-3.7-flash, which is
# verified to serve schema-constrained JSON on the free tier (3.6-flash was
# exhausted/503s, and free-tier quota is 20 req/day PER model — if one model
# 429s, switch GEMINI_MODEL to another flash model with a fresh bucket).
#GEMINI_MODEL=gemini-3.7-flash

# Optional: max wall-clock for one background pipeline run (default 300000 = 5 min).
#PIPELINE_TIMEOUT_MS=300000

# --- Endpoint protection (Phase 3) ---
# Comma-separated list of browser origins allowed by CORS. Defaults to local
# Vite dev only — set this to the deployed frontend origin in production.
#CORS_ORIGIN=http://localhost:5173,https://your-frontend.example

# Optional shared-secret gate on POST /api/pipeline/runs. Leave unset to
# disable (local dev unaffected). When set, callers must send the same value
# in an `x-studiomind-key` header — coordinate with the frontend before
# turning this on, it changes the fetch call.
#APP_SHARED_SECRET=

# Hard cap on brief length in characters, enforced before any DB/model call.
#BRIEF_MAX_CHARS=2000
